#!/bin/bash

# These scripts never make dpkg fail half-way (they always end with "exit 0"). So when a step
# does not work, say it clearly: the admin must be able to see it in the apt output.
warn() { echo "WARNING: $*" >&2; }

# Files that must survive from one of these scripts to the next are kept here.
# Only root may write to this folder. Never use a folder in /tmp for this: any user can create
# it first, and /tmp is emptied on a reboot.
STATE_DIR=/var/lib/homebridge-apt-pkg
SAVED_PACKAGE_JSON="$STATE_DIR/package.json.saved"

ensure_state_dir() {
  if [ -L "$STATE_DIR" ] || { [ -e "$STATE_DIR" ] && [ ! -d "$STATE_DIR" ]; }; then
    echo "WARNING: $STATE_DIR is not a normal folder. It will not be used, so the plugin list can not be carried over." >&2
    return 1
  fi
  mkdir -p "$STATE_DIR" && chown root:root "$STATE_DIR" && chmod 700 "$STATE_DIR"
}

# Folders that "preinst upgrade" moves aside (to "<name>.apt-old"). See the note there.
MOVED_ASIDE=(
  /var/lib/homebridge/node_modules/homebridge
  /opt/homebridge/lib/node_modules/homebridge-config-ui-x/node_modules/node-pty-prebuilt-multiarch/build
  /opt/homebridge/lib/node_modules/homebridge-config-ui-x/node_modules/@homebridge/node-pty-prebuilt-multiarch/build
)

# old_plugin_list: print a plugin list (package.json content) for an old "hb-service install"
# set-up. The plugins are the "homebridge-*" packages in npm's global folder. That folder is the
# one the old systemd unit starts the UI from, or one of the two usual places.
old_plugin_list() {
  local from_unit dir manifest
  from_unit=$(grep -oE '/[^ "]*/node_modules/homebridge-config-ui-x/' /etc/systemd/system/homebridge.service 2> /dev/null | head -n 1)
  for dir in "${from_unit%/homebridge-config-ui-x/}" /usr/local/lib/node_modules /usr/lib/node_modules; do
    if [ -z "$dir" ] || [ ! -d "$dir" ]; then
      continue
    fi
    for manifest in "$dir"/homebridge-*/package.json "$dir"/@*/homebridge-*/package.json; do
      [ -f "$manifest" ] || continue
      jq -c 'select((.name | type) == "string" and (.version | type) == "string") | {(.name): .version}' "$manifest" 2> /dev/null
    done
  done | jq -s '{dependencies: ((add // {}) | del(.["homebridge-config-ui-x"]) | del(.homebridge))}'
}

# before install
if [ "$1" = "install" ]; then
  echo "Running pre-install steps..."

  # make sure the package is not being installed using the Homebridge UI integrated terminal
  # unless UPDATE_HOMEBRIDGE_FORCE=1 is set
  if [ "$UPDATE_HOMEBRIDGE_FORCE" != "1" ]; then
    if pstree -s $$ | grep -q "hb-service"; then
      echo
      >&2 echo "ERROR: The homebridge package must not be installed from the Homebridge UI Terminal."
      echo
      exit 1
    fi
  fi

  # remove the hb-service generated fix-permission pre-start script (fresh install only!)
  if [ -z "$2" ] && [ -f /etc/hb-service/homebridge/prestart.d/10-fix-permissions ]; then
    rm -rf /etc/hb-service/homebridge/prestart.d/10-fix-permissions
  fi

  # check for existing homebridge.service 
  if [ -f /etc/systemd/system/homebridge.service ]; then
    # An old "hb-service install" set-up keeps Homebridge and its plugins in npm's global folder.
    # Make a list of those plugins, so that postinst installs them again in the new place.
    # The list is read from the files on disk. (It used to be asked from the running UI with a
    # home-made login token. The UI has refused such tokens since v5.24.0, so no plugin came over.)
    if [ ! -f /var/lib/homebridge/package.json ] && [ -f /var/lib/homebridge/config.json ]; then
      packageJson=$(old_plugin_list)
      if [ "$(jq '.dependencies | length' <<< "$packageJson" 2> /dev/null)" -gt 0 ] 2> /dev/null; then
        echo "Found plugins of the old install. They will be installed again in /var/lib/homebridge."
        ensure_state_dir && printf '%s\n' "$packageJson" > "$SAVED_PACKAGE_JSON"
      fi
    fi

    # stop homebridge.service if it is running
    if systemctl is-active --quiet homebridge.service; then
      echo "Stopping existing Homebridge service..."
      systemctl stop homebridge.service
    fi

    # disable and remove the old homebridge.service
    echo "Removing existing Homebridge service..."
    systemctl disable homebridge.service
    rm -rf /etc/systemd/system/homebridge.service
    systemctl daemon-reload
  fi

fi

# before an upgrade
if [ "$1" = "upgrade" ] && [ -n "$2" ]; then
  echo "Running pre-upgrade steps..."

  # make sure the package is not being upgraded using the Homebridge UI integrated terminal
  # unless UPDATE_HOMEBRIDGE_FORCE=1 is set
  if [ "$UPDATE_HOMEBRIDGE_FORCE" != "1" ]; then
    if pstree -s $$ | grep -q "hb-service"; then
      echo
      >&2 echo "ERROR: The homebridge package must not be upgraded from the Homebridge UI Terminal."
      echo
      exit 1
    fi
  fi
 
  # stop homebridge.service if it is running, and remember that it was running
  if systemctl is-active --quiet homebridge.service; then
    echo "Stopping Homebridge service..."
    ensure_state_dir && touch "$STATE_DIR/was-running"
    systemctl stop homebridge.service 2> /dev/null
  fi

  # take a copy of the existing "package.json" (a real file only: the folder belongs to the service user)
  if [ -f /var/lib/homebridge/package.json ] && [ ! -L /var/lib/homebridge/package.json ]; then
    ensure_state_dir && cp /var/lib/homebridge/package.json "$SAVED_PACKAGE_JSON"
  fi

  # Nothing is deleted in this script. If unpacking the new files fails (for example the disk is
  # full), dpkg puts the old files back, and "postrm abort-upgrade" undoes the steps below.
  # - package.json and .npmrc belong to the package: dpkg replaces them, and restores them.
  # - The folders below can hold files dpkg does not know (Homebridge updated from the UI,
  #   node-pty built on this machine). They are moved aside so the new files land in a clean
  #   place. postinst deletes the old copies once the upgrade has worked.
  for dir in "${MOVED_ASIDE[@]}"; do
    rm -rf "$dir.apt-old"
    if [ -d "$dir" ] && [ ! -L "$dir" ]; then
      mv "$dir" "$dir.apt-old" || warn "could not move $dir aside. Old files may be left in it."
    fi
  done
fi

echo "Unpacking may take several minutes on low powered devices."

exit 0
