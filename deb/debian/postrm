#!/bin/bash

STATE_DIR=/var/lib/homebridge-apt-pkg

# Folders that "preinst upgrade" moves aside (to "<name>.apt-old"). See the note there.
MOVED_ASIDE=(
  /var/lib/homebridge/node_modules/homebridge
  /opt/homebridge/lib/node_modules/homebridge-config-ui-x/node_modules/node-pty-prebuilt-multiarch/build
  /opt/homebridge/lib/node_modules/homebridge-config-ui-x/node_modules/@homebridge/node-pty-prebuilt-multiarch/build
)

# The upgrade failed while the new files were unpacked (for example the disk is full).
# dpkg has put the old files back. Undo what "preinst upgrade" did, so Homebridge runs as before.
if [ "$1" = "abort-upgrade" ]; then
  echo "The Homebridge upgrade did not finish. Putting the previous version back..."
  for dir in "${MOVED_ASIDE[@]}"; do
    if [ -d "$dir.apt-old" ]; then
      rm -rf "$dir"
      mv "$dir.apt-old" "$dir"
    fi
  done
  rm -f "$STATE_DIR/package.json.saved"
  if [ -e "$STATE_DIR/was-running" ]; then
    rm -f "$STATE_DIR/was-running"
    echo "Starting Homebridge service...."
    systemctl start homebridge.service
  fi
fi

# if removing - ensure app data is gone, but keep user data unless purging
if [ "$1" = "remove" ]; then
  echo "Running post-remove steps..."
  # prerm has already stopped and disabled the service, while its files were still there.
  # This stop is only for the rare case where that did not work.
  systemctl stop homebridge.service 2> /dev/null

  # remove symlink to hb-shell
  rm -rf /usr/local/bin/hb-shell

  # remove symlink to hb-service-shim
  rm -rf /usr/local/bin/hb-service

  # ensure package is completely gone
  rm -rf /var/lib/homebridge/node_modules /var/lib/homebridge/package-lock.json /var/lib/homebridge/pnpm-lock.yaml
  rm -rf /opt/homebridge

  # the unit file is gone now: tell systemd
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
  fi
fi

# if purging - delete the /var/lib/homebridge folder entirely
if [ "$1" = "purge" ]; then
  echo "Running post-purge steps..."
  rm -rf /var/lib/homebridge
  echo "Removed /var/lib/homebridge"
  rm -rf /var/lib/homebridge-apt-pkg
fi

exit 0
