#!/bin/bash

if [ "$(id -u)" -ne 0 ]; then
  echo "This command must be executed as root or with sudo."
  exit 1
fi

# default shell user
SHELL_USER=homebridge
SHELL_USER_HOME=/home/homebridge

function check_shell_user_override {
  # The user the service runs as: "homebridge", or the User= of a systemd override.
  # systemd is asked, because it knows every override file and which line wins.
  local unit_user
  unit_user=$(systemctl show -p User --value homebridge.service 2> /dev/null)
  if [ -n "$unit_user" ]; then
    if id -nu "$unit_user" > /dev/null 2>&1; then
      SHELL_USER=$(id -nu "$unit_user")
    else
      echo "ERROR: User '$unit_user', which the homebridge service is set to run as, does not exist on the system!"
    fi
  fi

  # the home folder comes from the user database
  SHELL_USER_HOME=$(getent passwd "$SHELL_USER" | cut -d: -f6)
  [ -n "$SHELL_USER_HOME" ] || SHELL_USER_HOME=/home/homebridge
}

# exec_as_service_user <command> [arguments]: replace this process with the command, run as the
# service user in the storage folder, with a clean environment. This is what "sudo --user" did
# before; "runuser" is part of every Debian and Ubuntu system, "sudo" is not.
function exec_as_service_user {
  cd /var/lib/homebridge || exit 1
  exec runuser -u "$SHELL_USER" -- env -i \
    "HOME=$SHELL_USER_HOME" "USER=$SHELL_USER" "LOGNAME=$SHELL_USER" "SHELL=/bin/bash" \
    "PATH=${PATH:-/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin}" \
    "TERM=${TERM:-dumb}" "LANG=${LANG:-C.UTF-8}" \
    "$@"
}

# read_plugin_name <folder>: set $package_name from the package.json in that folder, or stop.
# The name becomes part of a path under node_modules, so only a real npm package name is accepted
# (no "..", no extra "/", not empty).
function read_plugin_name {
  if ! package_name=$(jq -er '.name | strings' "$1/package.json" 2> /dev/null); then
    echo "Error: Could not read plugin name in package.json"
    exit 1
  fi
  if [[ ! "$package_name" =~ ^(@[A-Za-z0-9~-][A-Za-z0-9._~-]*/)?[A-Za-z0-9~-][A-Za-z0-9._~-]*$ ]]; then
    echo "Error: \"$package_name\" is not a valid plugin name."
    exit 1
  fi
}

# default port
PORT=8581

function check_port_override {
  # digits only: a UI block without a port must not turn the port into the word "null"
  if [ -f /var/lib/homebridge/config.json ]; then
    PORT_FROM_CONFIG=$(jq -r '.platforms[]? | select(.platform == "config") | .port // empty' /var/lib/homebridge/config.json 2> /dev/null | head -n 1)
    if [[ "$PORT_FROM_CONFIG" =~ ^[0-9]+$ ]]; then
      PORT=$PORT_FROM_CONFIG
    fi
  fi
}

# SC2016: in the commands that run as the service user, "$@" must reach the inner bash as text.
# It is expanded there, not here.
# shellcheck disable=SC2016
case "$1" in
  "start")
    echo "Starting Homebridge..."
    systemctl start homebridge.service
    ;;

  "stop")
    echo "Stopping Homebridge..."
    systemctl stop homebridge.service
    ;;

  "restart")
    echo "Restarting Homebridge..."
    systemctl restart homebridge.service
    ;;

  # In the commands below the arguments are handed over one by one ("$@"). They are never joined
  # into one line of shell text: "hb-service add 'homebridge-foo@>=2.0.0'" must not turn the ">"
  # into a redirect.
  "update-node" | "rebuild")
    check_shell_user_override
    exec_as_service_user bash --rcfile /opt/homebridge/source.sh -ci 'hb-service "$@"' hb-service "$@"
    ;;

  "status")
    check_shell_user_override
    check_port_override
    exec_as_service_user bash --rcfile /opt/homebridge/source.sh -ci 'hb-service status --port "$1"' hb-service "$PORT"
    ;;

  "add" | "remove")
    check_shell_user_override
    exec_as_service_user bash --rcfile /opt/homebridge/source.sh -ci 'npm --prefix /var/lib/homebridge "$@"' npm "$@"
    ;;

  "link")
    check_shell_user_override
    target_dir="$(pwd)"
    if [ "$target_dir" = "/var/lib/homebridge" ]; then
      echo "Error: Cannot run link command in /var/lib/homebridge"
      exit 1
    fi

    if [ ! -f "$target_dir/package.json" ]; then
      echo "Error: Target directory ($target_dir) does not contain a package.json file."
      exit 1
    fi

    read_plugin_name "$target_dir"

    target_link="/var/lib/homebridge/node_modules/$package_name"
    target_dirname="$(dirname "$target_link")"

    if [ ! -d "$target_dirname" ]; then
      mkdir -p "$target_dirname"
      chown -h "$SHELL_USER": "$target_dirname"
    fi

    if [ -L "$target_link" ]; then
      if [ "$(realpath "$target_link")" = "$(realpath "$target_dir")" ]; then
        echo "Error: $package_name is already linked."
        exit 1
      fi
      # a link to another source folder is replaced below
    elif [ -e "$target_link" ]; then
      # "ln" would put the link INSIDE the installed folder, and the installed copy would stay in use
      echo "Error: $package_name is installed as a normal plugin, so it can not be linked."
      echo "Remove the installed plugin first: hb-service remove $package_name"
      exit 1
    fi

    if ln -sfn "$target_dir" "$target_link" && chown -h "$SHELL_USER": "$target_link"; then
      echo "Success: $package_name linked"
    else
      echo "Error: could not link $package_name"
      exit 1
    fi
    ;;

  "unlink")
    check_shell_user_override
    target_dir="$(pwd)"
    if [ "$target_dir" = "/var/lib/homebridge" ]; then
      echo "Error: Cannot run unlink command in /var/lib/homebridge"
      exit 1
    fi
    if [ ! -f "$target_dir/package.json" ]; then
      echo "Error: Target directory ($target_dir) does not contain a package.json file."
      exit 1
    fi
    read_plugin_name "$target_dir"
    target_link="/var/lib/homebridge/node_modules/$package_name"
    # only ever remove a link, and only the link that points at this folder
    if [ ! -L "$target_link" ]; then
      if [ -e "$target_link" ]; then
        echo "Error: $package_name is installed as a normal plugin, it is not linked. Nothing was removed."
        echo "To remove an installed plugin use: hb-service remove $package_name"
      else
        echo "Error: $package_name is not linked."
      fi
      exit 1
    fi
    if [ "$(realpath "$target_link")" != "$(realpath "$target_dir")" ]; then
      echo "Error: $package_name is linked to another folder: $(realpath "$target_link"). Nothing was removed."
      exit 1
    fi
    if rm "$target_link"; then
      echo "Success: $package_name unlinked"
    fi
    ;;

  "logs")
    exec tail -n 100 -f /var/lib/homebridge/homebridge.log
    ;;

  "view")
    exec tail -n 100 /var/lib/homebridge/homebridge.log
    ;;

  "shell")
    exec /opt/homebridge/hb-shell
    ;;

  "install")
    echo "The 'hb-service install' command is not available when Homebridge is running as a system package."
    exit 1
    ;;

  "uninstall")
    echo "The 'hb-service uninstall' command is not available when Homebridge is running as a system package."
    exit 1
    ;;

  "-V")
    # read the version from the installed files (the Homebridge start file has another name in
    # Homebridge 2, and root has no "node" on its PATH)
    if ! jq -er '.version | strings' /var/lib/homebridge/node_modules/homebridge/package.json 2> /dev/null; then
      echo "Error: Homebridge is not installed in /var/lib/homebridge/node_modules."
      exit 1
    fi
    ;;

  "-D")
    echo "The 'hb-service -D' command is not available when Homebridge is running as a system package."
    echo "To see debug messages, turn on 'Homebridge Debug Mode' in the settings of the Homebridge UI,"
    echo "then watch the log with: hb-service logs"
    exit 1
    ;;

  *)
    printf '%s\n' \
      "Usage: hb-service [start|stop|restart|add|remove|link|unlink|update-node|rebuild|logs|view|status|shell|-V]" \
      ""   \
      "This hb-service command is provided by Homebridge APT Package" \
      "" \
      "Please provide a command:" \
      "    start                            start the homebridge service" \
      "    stop                             stop the homebridge service" \
      "    restart                          restart the homebridge service" \
      "    add <plugin>@<version>           install a plugin" \
      "    remove <plugin>@<version>        remove a plugin" \
      "    link                             adds the current directory to Homebridge for plugin development" \
      "    unlink                           reverses the link operation for the current directory" \
      "    update-node [version]            update Node.js" \
      "    rebuild                          rebuild the native modules of the UI and of the plugins" \
      "    logs                             tails the homebridge service logs" \
      "    view                             view the homebridge service logs" \
      "    status                           check if the Homebridge UI web server is running" \
      "    shell                            open the Homebridge Terminal" \
      "    -V                               print the Homebridge version" \
      "" \
      "See the wiki for help with hb-service: https://homebridge.io/w/JTtHK"
    # a command that does not exist is an error; no command at all (or "help") just shows the list
    case "$1" in
      "" | "help" | "-h" | "--help") ;;
      *) exit 1 ;;
    esac
    ;;
esac
