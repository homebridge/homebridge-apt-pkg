#!/bin/bash

# These scripts never make dpkg fail half-way (they always end with "exit 0"). So when a step
# does not work, say it clearly: the admin must be able to see it in the apt output.
warn() { echo "WARNING: $*" >&2; }

# Files that must survive from one of these scripts to the next are kept here.
# Only root may write to this folder. Never use a folder in /tmp for this: any user can create
# it first, and /tmp is emptied on a reboot.
STATE_DIR=/var/lib/homebridge-apt-pkg
SAVED_PACKAGE_JSON="$STATE_DIR/package.json.saved"

ensure_state_dir() {
  if [ -L "$STATE_DIR" ] || { [ -e "$STATE_DIR" ] && [ ! -d "$STATE_DIR" ]; }; then
    echo "WARNING: $STATE_DIR is not a normal folder. It will not be used, so the plugin list can not be carried over." >&2
    return 1
  fi
  mkdir -p "$STATE_DIR" && chown root:root "$STATE_DIR" && chmod 700 "$STATE_DIR"
}

# Folders that "preinst upgrade" moves aside (to "<name>.apt-old"). See the note there.
MOVED_ASIDE=(
  /var/lib/homebridge/node_modules/homebridge
  /opt/homebridge/lib/node_modules/homebridge-config-ui-x/node_modules/node-pty-prebuilt-multiarch/build
  /opt/homebridge/lib/node_modules/homebridge-config-ui-x/node_modules/@homebridge/node-pty-prebuilt-multiarch/build
)

# post-install and post-upgrade
if [ "$1" = "configure" ]; then
  # the upgrade worked: delete what "preinst upgrade" moved aside, and old lock files
  for dir in "${MOVED_ASIDE[@]}"; do
    rm -rf "$dir.apt-old"
  done
  rm -f /var/lib/homebridge/package-lock.json /var/lib/homebridge/pnpm-lock.yaml

  # Was the service running before this install or upgrade? "preinst upgrade" leaves a note when
  # it stops the service. It may also still be running (for example "dpkg-reconfigure").
  WAS_RUNNING=0
  [ -e "$STATE_DIR/was-running" ] && WAS_RUNNING=1
  if systemctl is-active --quiet homebridge.service 2> /dev/null; then
    WAS_RUNNING=1
    echo "Stopping Homebridge service..."
    systemctl stop homebridge.service 2> /dev/null
  fi

  # A first install, or an install after "apt remove" (prerm leaves a note for that). After a
  # remove, dpkg still passes the old version as $2, so $2 alone can not tell the two apart.
  FRESH_INSTALL=0
  if [ -z "$2" ] || [ -e "$STATE_DIR/removed" ]; then
    FRESH_INSTALL=1
  fi
fi

# post-install and post-upgrade: the service user must exist before npm runs as that user
if [ "$1" = "configure" ]; then
  # create user
  if ! getent passwd homebridge > /dev/null; then
    adduser --system --group homebridge --home /home/homebridge > /dev/null \
      || warn "could not create the 'homebridge' user. The Homebridge service can not start without it."
  fi

  # some old versions didn't create the homebridge group
  if ! getent group homebridge > /dev/null; then
    { addgroup --system homebridge > /dev/null && usermod -g homebridge homebridge; } \
      || warn "could not create the 'homebridge' group."
  fi

  # copy .bashrc to service user home, and give it to that user
  { cp /opt/homebridge/bashrc /home/homebridge/.bashrc && chown homebridge: /home/homebridge/.bashrc; } \
    || warn "could not write /home/homebridge/.bashrc."
fi

# The user the service runs as: "homebridge", or the User= of a systemd override.
service_user() {
  local user
  user=$(systemctl show -p User --value homebridge.service 2> /dev/null)
  [ -n "$user" ] || user=homebridge
  id -nu "$user" 2> /dev/null || echo homebridge
}

if [ "$1" = "configure" ] && ensure_state_dir && [ -f "$SAVED_PACKAGE_JSON" ] && [ ! -L "$SAVED_PACKAGE_JSON" ] && [ -f /var/lib/homebridge/package.json ]; then
  echo "Merging package.json file..."

  # The user's plugin list and the list this package ships become one file. The UI is never part
  # of it. The result is written to a new file and checked before it replaces package.json, so a
  # problem can never leave an empty or half-written plugin list behind.
  MERGED_PACKAGE_JSON="$STATE_DIR/package.json.merged"
  #
  # Alpha and beta packages used to ship the "homebridge-plugin-update-check" plugin. They now ship
  # "homebridge-updater", which replaces it and takes over its settings. When this package ships
  # the updater, the old plugin is taken out of the list (dpkg has already removed its files).
  merge_plugin_list() {
    jq -M -s '(.[0] * .[1])
      | del(.dependencies["homebridge-config-ui-x"])
      | if (.dependencies | has("@homebridge-plugins/homebridge-updater"))
        then del(.dependencies["@homebridge-plugins/homebridge-plugin-update-check"]) else . end' \
      "$1" /var/lib/homebridge/package.json > "$MERGED_PACKAGE_JSON" 2> /dev/null \
      && jq -e '(.dependencies | type) == "object"' "$MERGED_PACKAGE_JSON" > /dev/null 2>&1
  }

  PLUGIN_LIST_MERGED=1
  if ! merge_plugin_list "$SAVED_PACKAGE_JSON"; then
    echo "WARNING: the saved plugin list is not valid JSON. It is kept as $STATE_DIR/package.json.not-merged."
    echo "Building the plugin list from the plugins found in node_modules instead."
    cp "$SAVED_PACKAGE_JSON" "$STATE_DIR/package.json.not-merged"
    if ! /opt/homebridge/rebuild-package-json.sh /var/lib/homebridge > "$STATE_DIR/package.json.rebuilt" \
      || ! merge_plugin_list "$STATE_DIR/package.json.rebuilt"; then
      PLUGIN_LIST_MERGED=0
    fi
    rm -f "$STATE_DIR/package.json.rebuilt"
  fi

  if [ "$PLUGIN_LIST_MERGED" = "1" ]; then
    chmod 644 "$MERGED_PACKAGE_JSON"
    mv -f "$MERGED_PACKAGE_JSON" /var/lib/homebridge/package.json
  else
    rm -f "$MERGED_PACKAGE_JSON"
    echo "WARNING: could not merge the plugin list. Your plugins are not removed, but they are missing from /var/lib/homebridge/package.json."
  fi

  # Re-install user plugins. Not when the merge failed: "npm install" removes every plugin
  # that is not in package.json.
  if [ "$PLUGIN_LIST_MERGED" = "1" ]; then
    echo "Refreshing user plugins, this may take a few minutes, please wait..."
    echo ""
    # npm runs the install scripts of every plugin, so it must run as the service user, never as
    # root. For the same reason root does not load /opt/homebridge/source.sh (or its hooks) here.
    SERVICE_USER=$(service_user)
    SERVICE_HOME=$(getent passwd "$SERVICE_USER" | cut -d: -f6)
    chown -R "$SERVICE_USER": /var/lib/homebridge
    runuser -u "$SERVICE_USER" -- env "HOME=${SERVICE_HOME:-/var/lib/homebridge}" "USER=$SERVICE_USER" "LOGNAME=$SERVICE_USER" \
      sh -c '. /opt/homebridge/source.sh && cd /var/lib/homebridge && npm --prefix /var/lib/homebridge install && npm --prefix /var/lib/homebridge rebuild' \
      || warn "npm could not refresh the plugins (is the network up?). Some plugins may not start. To try again: run 'sudo hb-shell', then 'npm --prefix /var/lib/homebridge install'."
    echo ""
  fi

  # the saved copy has been used
  rm -f "$SAVED_PACKAGE_JSON"
fi

# post-install and post-upgrade
if [ "$1" = "configure" ]; then
  echo "Running post-install steps..."

  # add user to default groups if running on raspbian
  if [ -f /usr/bin/raspi-config ]; then
    for groupName in udio bluetooth dialout gpio video input i2c spi audio render; do
      usermod -a -G "$groupName" homebridge 2> /dev/null
    done
  fi

  # on install only
  # if running on Offical Homebridge Raspberry Pi, run as the "pi" user (uid 1000) instead
  if [ -z "$2" ] && [ -f /usr/bin/raspi-config ] && [ -f /etc/hb-release ] && [ ! -f /etc/systemd/system/homebridge.service.d/override.conf ]; then
    getent passwd 1000 > /dev/null
    if [ "$?" -eq 0 ]; then
      mkdir -p /etc/systemd/system/homebridge.service.d
      echo "[Service]" > /etc/systemd/system/homebridge.service.d/override.conf
      echo "User=1000" >> /etc/systemd/system/homebridge.service.d/override.conf
      echo "Environment=\"UIX_CAN_SHUTDOWN_RESTART_HOST=1\"" >> /etc/systemd/system/homebridge.service.d/override.conf
      echo "Environment=\"UIX_STORAGE_PATH=/var/lib/homebridge\"" >> /etc/systemd/system/homebridge.service.d/override.conf
    fi
  fi

  # The service:
  # - first install: turn it on (enable) and start it;
  # - upgrade: start it again only if it was running before. An admin who stopped or disabled
  #   the service keeps it that way, and a mask is never removed;
  # - no running systemd (a chroot while a system image is built, a container): nothing is
  #   started. "enable" still works there, so the service starts on the first real boot.
  if command -v systemctl > /dev/null 2>&1; then
    SYSTEMD_RUNNING=0
    [ -d /run/systemd/system ] && SYSTEMD_RUNNING=1
    [ "$SYSTEMD_RUNNING" = "1" ] && systemctl daemon-reload

    # The mDNS permission rule (polkit, see /usr/share/polkit-1/rules.d/homebridge.rules) is for
    # members of the group "homebridge". When the service runs as another user (a systemd
    # override, or user 1000 on older Raspberry Pi images), add that user to the group: polkit
    # looks at the groups of the user, not at the extra groups of the service process.
    SERVICE_USER=$(service_user)
    if [ "$SERVICE_USER" != "homebridge" ] && [ "$SERVICE_USER" != "root" ]; then
      usermod -a -G homebridge "$SERVICE_USER" \
        || warn "could not add the user '$SERVICE_USER' to the group 'homebridge'."
    fi

    if [ "$FRESH_INSTALL" = "1" ]; then
      systemctl enable homebridge.service \
        || warn "could not enable the Homebridge service. It will not start when the machine boots."
    fi

    if [ "$SYSTEMD_RUNNING" = "1" ]; then
      if [ "$FRESH_INSTALL" = "1" ] || [ "$WAS_RUNNING" = "1" ]; then
        echo "Starting Homebridge service...."
        systemctl restart homebridge.service \
          || warn "the Homebridge service did not start. To see why: journalctl -u homebridge -n 50"
      else
        echo "The Homebridge service was not running before the upgrade, so it is not started."
        echo "Start it with: systemctl start homebridge"
      fi
    fi
  fi

  # create symlinks to hb-shell and to hb-service-shim
  { ln -fs /opt/homebridge/hb-shell /usr/local/bin/hb-shell && ln -fs /opt/homebridge/hb-service-shim /usr/local/bin/hb-service; } \
    || warn "could not create the hb-shell and hb-service commands in /usr/local/bin."

  # remove symlinks create by npm for global hb-service installs
  rm -rf /usr/bin/hb-service

  rm -f "$STATE_DIR/was-running" "$STATE_DIR/removed"
fi

# first install only (or the first install after a remove)
if [ "$1" = "configure" ] && [ "$FRESH_INSTALL" = "1" ]; then
  IP=$(hostname -I)
  PORT=8581

  # check to see if an alternate port is defined in the config (digits only: a UI block
  # without a port must not turn the port into the word "null")
  if [ -f /var/lib/homebridge/config.json ]; then
    PORT_FROM_CONFIG=$(jq -r '.platforms[]? | select(.platform == "config") | .port // empty' /var/lib/homebridge/config.json 2> /dev/null | head -n 1)
    if [[ "$PORT_FROM_CONFIG" =~ ^[0-9]+$ ]]; then
      PORT=$PORT_FROM_CONFIG
    fi
  fi

  # create ufw firewall rules
  if [ -e "/usr/sbin/ufw" ]; then
    if ufw status 2> /dev/null | head -n 1 | grep -qw "active"; then
      echo ""
      if ufw allow "$PORT/tcp" > /dev/null; then
        echo "Added local firewall rule to allow inbound traffic on port $PORT/tcp."
        echo "Run \"ufw status\" to view all active firewall rules."
      else
        echo "You may need to create a firewall rule to allow access to port $PORT/tcp before you can access the Homebridge UI."
      fi
      echo "You may need to create additional firewall rules to allow HomeKit access to the main Homebridge port and any Child Bridge ports."
    fi
  fi

  echo ""
  echo "Homebridge Installation Complete!"
  echo "You can access the Homebridge UI via:"
  echo ""

  for ip in $IP; do
    if [[ $ip =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
      echo "* http://$ip:$PORT"
    else
      echo "* http://[$ip]:$PORT"
    fi
  done

  echo ""
  echo "Thanks for installing Homebridge!"
  echo ""
fi

exit 0
